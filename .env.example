# Database Configuration (MySQL Async)
DATABASE_URL=mysql+aiomysql://<db_user>:<db_password>@<db_host>:3306/<db_name>

# JWT Authentication
# Generate via: openssl rand -hex 32
JWT_SECRET=<your_32_bytes_random_secret_key>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Asterisk PBX WebRTC / SIP Settings
ASTERISK_WSS_URL=wss://<your-pbx-domain>/ws
SIP_DOMAIN=<your-sip-domain-or-realm>
